---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
export function getStaticPaths(){return site.apps.map(app=>({params:{slug:app.slug},props:{app}}))}
const {app}=Astro.props;
---
<Layout title={`${app.name} | Budding Intents`} description={app.description}><section class="detail section"><a class="text-link" href="/#apps">All apps</a><span class="eyebrow">{app.category} / ANDROID</span><h1>{app.name}</h1><p class="lede">{app.description}</p><div class="actions"><a class="button primary" href={app.playUrl}>View on Google Play</a><a class="button" href={app.sourceUrl}>Explore source code</a></div><div class={`feature-banner ${app.accent}`}><h2>{app.tagline.replace('\n',' ')}</h2></div><div class="features">{app.features.map((feature,i)=><div><span class="eyebrow">0{i+1}</span><h3>{feature}</h3></div>)}</div><p>For current features, availability, pricing, and app privacy information, see the Google Play listing.</p><a class="text-link" href="/contact/">Questions or feedback? Get in touch</a></section></Layout>
