---
import site from '../data/site.json';
import '../styles.css';
const {title=site.title, description=site.intro}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><title>{title}</title><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('bi-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/" aria-label="Budding Intents home"><span class="mark">bi.</span><span>Budding<br/>Intents</span></a><nav aria-label="Main navigation"><a href="/#apps">Apps</a><a href="/#journal">Journal</a><a href="/#about">About</a><a href="/contact/">Contact</a></nav><button id="theme" class="theme" aria-label="Switch colour theme">◐ <span>Theme</span></button></header><main id="main"><slot/></main><footer><a class="brand" href="/">Budding Intents<span class="period">.</span></a><p>Independent by choice. Built with intent.</p><div><a href={site.githubUrl}>GitHub</a><a href="/contact/">Say hello</a><a href="/privacy/">Privacy</a></div><small>© {new Date().getFullYear()} Ankit Sharma</small></footer><script>const b=document.querySelector('#theme');function label(){b?.setAttribute('aria-label',`Switch to ${document.documentElement.dataset.theme==='dark'?'light':'dark'} theme`)}label();b?.addEventListener('click',()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;try{localStorage.setItem('bi-theme',t)}catch{}label()});</script></body></html>
